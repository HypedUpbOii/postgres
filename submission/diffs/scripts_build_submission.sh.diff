index 0000000000..02929c4654
--- /dev/null
+++ b/scripts/build_submission.sh
@@ -0,0 +1,282 @@
+#!/bin/bash
+#
+# Build the submission/ deliverable folder + zip.
+#
+# Layout produced:
+#
+#   submission/
+#     README.md             — orientation for whoever opens the zip
+#     git_url.txt           — public fork URL
+#     INVENTORY.md          — list of every file we modified or added,
+#                             with its diff filename and original path
+#     diffs/                — one .diff per file we touched (modified
+#                             OR added).  Generated with `git diff` vs.
+#                             the upstream merge-base; new files appear
+#                             as +-only diffs.
+#     new_files/            — every file we authored, mirrored at its
+#                             original path inside the repo (so a
+#                             reviewer can pull the file directly).
+#     test_data/            — TPC-H queries + schema, TPC-C-lite schema,
+#                             load file, and the four transactions.
+#     report/
+#       submission_report.pdf
+#       report.pdf
+#   submission.zip          — the same folder, zipped for upload.
+#
+# Baseline: the script computes the upstream baseline as the *parent*
+# of our team's first commit (which itself contains team-authored
+# files).  That baseline is the last upstream PostgreSQL commit
+# reachable from our history.
+#
+# Idempotent: wipes submission/ + submission.zip at the top and
+# rebuilds.  Run from anywhere — paths are anchored to the script.
+#
+set -e
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
+SUBMISSION="$REPO_ROOT/submission"
+ZIP="$REPO_ROOT/submission.zip"
+
+# Our team's first commit; its parent is the upstream baseline.
+TEAM_FIRST_COMMIT="9a4faa1f02e4c13a578e5ef43a63c5350d72870f"
+
+cd "$REPO_ROOT"
+
+UPSTREAM_BASE=$(git rev-parse "${TEAM_FIRST_COMMIT}^")
+echo "[*] Upstream baseline: $UPSTREAM_BASE  (= ${TEAM_FIRST_COMMIT}^)"
+
+echo "[*] Wiping old submission/ and submission.zip ..."
+rm -rf "$SUBMISSION" "$ZIP"
+mkdir -p "$SUBMISSION/diffs" "$SUBMISSION/new_files" \
+         "$SUBMISSION/test_data" "$SUBMISSION/report"
+
+echo "[*] Writing git_url.txt ..."
+cat > "$SUBMISSION/git_url.txt" <<'EOF'
+https://github.com/HypedUpbOii/postgres
+EOF
+
+# ---------------------------------------------------------------------------
+# Resolve which files count as "ours" vs. "upstream" vs. "noise".
+#
+# Excludes:
+#   submission/            — generated by THIS script (would recurse)
+#   report/*.aux|fls|fdb_latexmk|log|out|toc|synctex.gz — LaTeX build noise
+# ---------------------------------------------------------------------------
+exclude_path() {
+    case "$1" in
+        submission/*) return 0 ;;
+        report/*.aux|report/*.fls|report/*.fdb_latexmk|report/*.log) return 0 ;;
+        report/*.out|report/*.toc|report/*.synctex.gz) return 0 ;;
+    esac
+    return 1
+}
+
+mapfile -t MODIFIED_RAW < <(git diff --diff-filter=M --name-only "$UPSTREAM_BASE"..HEAD)
+mapfile -t ADDED_RAW    < <(git diff --diff-filter=A --name-only "$UPSTREAM_BASE"..HEAD)
+
+MODIFIED=()
+for f in "${MODIFIED_RAW[@]}"; do
+    exclude_path "$f" || MODIFIED+=("$f")
+done
+
+ADDED=()
+for f in "${ADDED_RAW[@]}"; do
+    exclude_path "$f" || ADDED+=("$f")
+done
+
+# Local untracked authored files (e.g. submission_report.{md,tex,pdf}
+# during the run when they haven't yet been committed).
+UNTRACKED=()
+while IFS= read -r f; do
+    [ -z "$f" ] && continue
+    UNTRACKED+=("$f")
+done < <(git ls-files --others --exclude-standard | \
+         grep -vE '^submission/|^submission\.zip$|^report/.*\.(aux|fls|fdb_latexmk|log|out|toc|synctex\.gz)$' || true)
+
+echo "[*] Files to ship:  modified=${#MODIFIED[@]}  added=${#ADDED[@]}  untracked=${#UNTRACKED[@]}"
+
+# ---------------------------------------------------------------------------
+# Helper: filename for a diff file derived from the original repo path.
+# slashes -> _, leading dot dropped from .gitignore for readability.
+# ---------------------------------------------------------------------------
+diff_name() {
+    local p="$1"
+    # Replace path separators with underscores; keep leading dot files
+    # readable (.gitignore -> dotgitignore).
+    p="${p//\//_}"
+    p="${p#.}"   # drop leading dot if any
+    echo "${p}.diff"
+}
+
+# ---------------------------------------------------------------------------
+# diffs/ — one .diff per modified file AND per added file.
+# Added files render as +-only diffs against /dev/null, which is exactly
+# how `git diff` represents them.
+# ---------------------------------------------------------------------------
+echo "[*] Generating diffs (one per file we touched) ..."
+
+INVENTORY="$SUBMISSION/INVENTORY.md"
+{
+    echo "# Submission inventory"
+    echo
+    echo "Upstream baseline: \`$UPSTREAM_BASE\` (= \`${TEAM_FIRST_COMMIT}^\`,"
+    echo "the last commit reachable from our fork that came from"
+    echo "upstream PostgreSQL).  Everything below is our work."
+    echo
+    echo "## Modified upstream files"
+    echo
+    echo "| Original path | Diff file |"
+    echo "|---|---|"
+} > "$INVENTORY"
+
+for f in "${MODIFIED[@]}"; do
+    out=$(diff_name "$f")
+    git diff "$UPSTREAM_BASE"..HEAD -- "$f" > "$SUBMISSION/diffs/$out"
+    echo "| \`$f\` | [diffs/$out](diffs/$out) |" >> "$INVENTORY"
+done
+
+{
+    echo
+    echo "## New files we authored"
+    echo
+    echo "Each appears below with both a \`+\`-only diff (in \`diffs/\`)"
+    echo "and the file itself (mirrored at its original path under"
+    echo "\`new_files/\`)."
+    echo
+    echo "| Original path | Diff file | Mirrored at |"
+    echo "|---|---|---|"
+} >> "$INVENTORY"
+
+for f in "${ADDED[@]}"; do
+    out=$(diff_name "$f")
+    git diff "$UPSTREAM_BASE"..HEAD -- "$f" > "$SUBMISSION/diffs/$out"
+    echo "| \`$f\` | [diffs/$out](diffs/$out) | [new_files/$f](new_files/$f) |" >> "$INVENTORY"
+done
+
+# Untracked authored files we still want shipped (e.g. submission_report.*).
+# We can't `git diff` against upstream for an untracked file, so we
+# render the diff manually as a +-only block.
+if [ "${#UNTRACKED[@]}" -gt 0 ]; then
+    {
+        echo
+        echo "## Authored but uncommitted at build time"
+        echo
+        echo "| Original path | Diff file | Mirrored at |"
+        echo "|---|---|---|"
+    } >> "$INVENTORY"
+    for f in "${UNTRACKED[@]}"; do
+        [ -f "$f" ] || continue
+        out=$(diff_name "$f")
+        {
+            echo "diff --git a/$f b/$f"
+            echo "new file"
+            echo "--- /dev/null"
+            echo "+++ b/$f"
+            sed 's/^/+/' "$f"
+        } > "$SUBMISSION/diffs/$out"
+        echo "| \`$f\` | [diffs/$out](diffs/$out) | [new_files/$f](new_files/$f) |" >> "$INVENTORY"
+    done
+fi
+
+echo "    $(ls -1 "$SUBMISSION/diffs" | wc -l) diff files generated"
+
+# ---------------------------------------------------------------------------
+# new_files/ — every authored file mirrored at its original repo path.
+# ---------------------------------------------------------------------------
+echo "[*] Mirroring new files ..."
+mirror_count=0
+for f in "${ADDED[@]}" "${UNTRACKED[@]}"; do
+    [ -f "$f" ] || continue
+    dst="$SUBMISSION/new_files/$f"
+    mkdir -p "$(dirname "$dst")"
+    cp -p "$f" "$dst"
+    mirror_count=$((mirror_count + 1))
+done
+echo "    $mirror_count files mirrored"
+
+# ---------------------------------------------------------------------------
+# test_data/ — the actual benchmark workloads, also as a flat copy so
+# a reviewer doesn't need to dig into scripts/ to find the test inputs.
+# ---------------------------------------------------------------------------
+echo "[*] Copying test data ..."
+cp -r scripts/tpch_queries        "$SUBMISSION/test_data/tpch_queries"
+cp    scripts/tpch_schema.sql     "$SUBMISSION/test_data/"
+cp    scripts/tpcc_schema.sql     "$SUBMISSION/test_data/"
+cp    scripts/tpcc_load.sql       "$SUBMISSION/test_data/"
+cp -r scripts/tpcc_xn             "$SUBMISSION/test_data/tpcc_xn"
+echo "    $(find "$SUBMISSION/test_data" -type f | wc -l) test-data files copied"
+
+# ---------------------------------------------------------------------------
+# report/ — both PDFs.
+# ---------------------------------------------------------------------------
+echo "[*] Copying report PDFs ..."
+[ -f report/submission_report.pdf ] && cp report/submission_report.pdf "$SUBMISSION/report/"
+[ -f report/report.pdf ]            && cp report/report.pdf            "$SUBMISSION/report/"
+
+# ---------------------------------------------------------------------------
+# README.md — orientation for whoever opens the submission zip.
+# ---------------------------------------------------------------------------
+echo "[*] Writing submission/README.md ..."
+cat > "$SUBMISSION/README.md" <<'EOF'
+# auto_index — Project Submission
+
+PostgreSQL extension that observes live workload and automatically
+creates / drops indexes (singleton or composite up to 3 columns).
+
+**Public git repository (forked from `postgres/postgres`):**
+<https://github.com/HypedUpbOii/postgres>
+
+The link is also in `git_url.txt`.
+
+## What's in this folder
+
+| Path | Contents |
+|---|---|
+| `report/submission_report.pdf` | The submission report (motivation, functionality, code, testing, AI usage with prompts). |
+| `report/report.pdf` | Full technical report (architecture deep-dive + per-strategy benchmark numbers). |
+| `INVENTORY.md` | Table listing every file we modified or added, with the corresponding diff filename and (for new files) the mirror path. |
+| `diffs/` | One `.diff` file per file we touched.  Modified files are real `git diff`s; new files are `+`-only diffs against `/dev/null` (also produced by `git diff`).  Filenames are the original path with `/` replaced by `_`. |
+| `new_files/` | Every file we authored, mirrored at its original repository path so the layout matches the live repo. |
+| `test_data/` | TPC-H queries (Q1, Q3, Q5, Q6, Q10, Q12, Q14, Q19), TPC-H schema, TPC-C-lite schema + load + four transactions. The TPC-H raw `.tbl` data (~70 MB at SF=0.1) is *not* shipped — it is regenerated on demand by `scripts/lib/tpch_setup.sh` via `tpch-dbgen`. |
+
+## Reproducing the results
+
+The fastest path from a clean clone to all four headline benchmarks is:
+
+```bash
+git clone https://github.com/HypedUpbOii/postgres.git
+cd postgres
+scripts/quickstart.sh        # builds container, PG, extension, then runs a smoke pgbench demo
+```
+
+Then the four named benchmarks individually:
+
+```bash
+scripts/benchmark.sh pgbench    # ~52x live step in TPS
+scripts/benchmark.sh tpch       # 8-query 3-phase TPC-H (auto-runs setup)
+scripts/benchmark.sh tpcc       # TPC-C-lite OLTP
+scripts/demo.sh                 # full create-then-drop lifecycle (~90 s)
+```
+
+See `QUICKSTART.md` in the repository root for a detailed
+from-scratch walkthrough.
+EOF
+
+# ---------------------------------------------------------------------------
+# Zip
+# ---------------------------------------------------------------------------
+echo "[*] Zipping ..."
+( cd "$REPO_ROOT" && zip -qr "$ZIP" submission )
+
+echo ""
+echo "Submission built at: $SUBMISSION"
+echo "Submission zipped at: $ZIP  ($(du -h "$ZIP" | awk '{print $1}'))"
+echo ""
+echo "Top-level layout:"
+find "$SUBMISSION" -maxdepth 1 -mindepth 1 | sort | sed 's|^|  |'
+echo ""
+echo "diffs/ count:      $(ls "$SUBMISSION/diffs" | wc -l)"
+echo "new_files/ count:  $(find "$SUBMISSION/new_files" -type f | wc -l)"
+echo "test_data/ count:  $(find "$SUBMISSION/test_data" -type f | wc -l)"
+echo "report/ contents:  $(ls "$SUBMISSION/report")"
