diff --git a/scripts/lib/demo.sh b/scripts/lib/demo.sh
new file mode 100755
index 0000000000..631a8a8e0b
--- /dev/null
+++ b/scripts/lib/demo.sh
@@ -0,0 +1,237 @@
+#!/bin/bash
+#
+# auto_index lifecycle demo (in-container).
+#
+# A. Heavy reads → SINGLETON + COMPOSITE indexes get created.
+# B. Heavy writes (no reads on those columns) → both indexes get dropped
+#    by the ski-rental idle accumulator.
+#
+# Designed to fit in ~90 seconds end-to-end at default settings.
+#
+set -e
+
+export PATH=/usr/local/pgsql/bin:$PATH
+DB=postgres
+PSQL="psql -d $DB -X"
+
+ROWS=${ROWS:-50000}
+READ_ITERS=${READ_ITERS:-200}
+WRITE_ITERS=${WRITE_ITERS:-300}
+CHECK_INTERVAL=${CHECK_INTERVAL:-5}
+IDLE_INTERVALS=${IDLE_INTERVALS:-10}
+STRATEGY=${STRATEGY:-simple_threshold}
+SIMPLE_THRESHOLD=${SIMPLE_THRESHOLD:-10}
+THRESHOLD=${THRESHOLD:-2}
+
+WAIT_FOR_CREATE=$((CHECK_INTERVAL * 3 + 2))
+WAIT_FOR_DROP=$((CHECK_INTERVAL * IDLE_INTERVALS))
+
+SEP="================================================================"
+banner() { echo ""; echo "$SEP"; echo "  $1"; echo "$SEP"; }
+
+# Pretty print indexes auto_index has on demo_table.
+list_demo_indexes() {
+    $PSQL <<SQL
+SELECT
+    ic.relname                                  AS index_name,
+    auto_index_attnames(ai.relid, ai.attnos)    AS columns,
+    array_length(ai.attnos, 1)                  AS n_cols
+FROM auto_index_catalog ai
+JOIN pg_class c  ON c.oid  = ai.relid
+JOIN pg_class ic ON ic.oid = ai.indexrelid
+WHERE c.relname = 'demo_table'
+ORDER BY n_cols, ic.relname;
+SQL
+}
+
+count_demo_indexes() {
+    $PSQL -Atq <<SQL
+SELECT count(*) FROM auto_index_catalog ai
+JOIN pg_class c ON c.oid = ai.relid
+WHERE c.relname = 'demo_table';
+SQL
+}
+
+show_drop_state() {
+    $PSQL <<SQL
+SELECT
+    ic.relname                                   AS index_name,
+    array_length(ai.attnos, 1)                   AS n_cols,
+    ai.last_checked_idx_scan                     AS last_idx_scan,
+    s.idx_scan                                   AS current_idx_scan,
+    ai.idle_write_cost                           AS idle_accum
+FROM auto_index_catalog ai
+JOIN pg_class c  ON c.oid = ai.relid
+JOIN pg_class ic ON ic.oid = ai.indexrelid
+LEFT JOIN pg_stat_user_indexes s ON s.indexrelid = ai.indexrelid
+WHERE c.relname = 'demo_table'
+ORDER BY n_cols, ic.relname;
+SQL
+}
+
+# ---------------------------------------------------------------------------
+# Setup
+# ---------------------------------------------------------------------------
+banner "Setup: configure auto_index, build $ROWS-row demo_table"
+
+$PSQL -c "ALTER SYSTEM SET auto_index.create_strategy   = '$STRATEGY';"
+$PSQL -c "ALTER SYSTEM SET auto_index.threshold         = $THRESHOLD;"
+$PSQL -c "ALTER SYSTEM SET auto_index.simple_threshold  = $SIMPLE_THRESHOLD;"
+$PSQL -c "ALTER SYSTEM SET auto_index.check_interval    = $CHECK_INTERVAL;"
+pg_ctl -D /postgres/data restart -l /postgres/logfile -w -s
+
+$PSQL <<SQL
+CREATE EXTENSION IF NOT EXISTS auto_index;
+DO \$\$
+DECLARE r record;
+BEGIN
+    FOR r IN SELECT schemaname, indexname FROM pg_indexes
+             WHERE indexname LIKE 'auto\\_idx\\_%'
+    LOOP
+        EXECUTE format('DROP INDEX IF EXISTS %I.%I', r.schemaname, r.indexname);
+    END LOOP;
+END\$\$;
+DELETE FROM auto_index_catalog;
+SELECT auto_index_reset();
+
+DROP TABLE IF EXISTS demo_table CASCADE;
+CREATE TABLE demo_table (
+    id        serial PRIMARY KEY,
+    category  int,                          -- single-col target
+    region    text,                         -- composite col 1
+    status    text,                         -- composite col 2
+    amount    int,                          -- composite col 3 (range)
+    payload   text
+);
+
+INSERT INTO demo_table (category, region, status, amount, payload)
+SELECT (random()*99)::int,
+       (ARRAY['north','south','east','west'])[(random()*4)::int % 4 + 1],
+       (ARRAY['active','pending','closed'])[(random()*3)::int % 3 + 1],
+       (random()*10000)::int,
+       md5(random()::text)
+FROM generate_series(1, $ROWS);
+
+ANALYZE demo_table;
+SQL
+
+echo "demo_table: $($PSQL -Atq -c 'SELECT count(*) FROM demo_table') rows."
+echo "Strategy: $STRATEGY  (simple_threshold=$SIMPLE_THRESHOLD)"
+
+# ---------------------------------------------------------------------------
+# PHASE A: heavy reads → singleton + composite
+# ---------------------------------------------------------------------------
+banner "Phase A: heavy reads → expect SINGLETON + COMPOSITE indexes"
+
+echo "  - $READ_ITERS queries on    category = ?              (singleton candidate)"
+echo "  - $READ_ITERS queries on    region = ? AND status = ? AND amount > ?"
+echo "                               (composite candidate)"
+echo ""
+
+for i in $(seq 1 $READ_ITERS); do
+    cat=$((RANDOM % 100))
+    $PSQL -q -c "SELECT count(*) FROM demo_table WHERE category = $cat" > /dev/null
+done
+
+REGIONS=("north" "south" "east" "west")
+STATUSES=("active" "pending" "closed")
+for i in $(seq 1 $READ_ITERS); do
+    r="${REGIONS[$((RANDOM % 4))]}"
+    s="${STATUSES[$((RANDOM % 3))]}"
+    a=$((RANDOM % 10000))
+    $PSQL -q -c "SELECT count(*) FROM demo_table WHERE region='$r' AND status='$s' AND amount > $a" > /dev/null
+done
+
+echo "Done.  Waiting ${WAIT_FOR_CREATE}s for the bgworker to act..."
+sleep $WAIT_FOR_CREATE
+
+echo ""
+echo "Indexes auto_index has on demo_table:"
+list_demo_indexes
+
+INITIAL_COUNT=$(count_demo_indexes)
+if [ "$INITIAL_COUNT" -lt 1 ]; then
+    echo ""
+    echo "WARN: no indexes were created.  Try ROWS=200000 or lower SIMPLE_THRESHOLD."
+fi
+
+# ---------------------------------------------------------------------------
+# PHASE B: heavy writes → drop accumulator → both indexes go away
+# ---------------------------------------------------------------------------
+banner "Phase B: heavy writes (no reads on indexed cols) → expect DROP"
+
+echo "  - $WRITE_ITERS rounds of UPDATE / INSERT / DELETE (PK access only)"
+echo ""
+
+for i in $(seq 1 $WRITE_ITERS); do
+    id=$((RANDOM % ROWS + 1))
+    new_cat=$((RANDOM % 100))
+    new_amt=$((RANDOM % 10000))
+    $PSQL -q <<SQL > /dev/null
+UPDATE demo_table SET payload = md5(random()::text) WHERE id = $id;
+INSERT INTO demo_table (category, region, status, amount, payload)
+    VALUES ($new_cat, 'north', 'active', $new_amt, md5(random()::text));
+DELETE FROM demo_table WHERE id = $((RANDOM % ROWS + 1));
+SQL
+done
+
+echo "Wrote ~$((WRITE_ITERS * 3)) statements.  No reads on category/region/status/amount."
+
+banner "Watching the drop accumulator (max ${WAIT_FOR_DROP}s)"
+
+elapsed=0
+while [ $elapsed -lt $WAIT_FOR_DROP ]; do
+    sleep $CHECK_INTERVAL
+    elapsed=$((elapsed + CHECK_INTERVAL))
+
+    cnt=$(count_demo_indexes)
+    echo "  t=${elapsed}s  remaining_indexes=$cnt"
+    show_drop_state | sed 's/^/    /'
+
+    if [ "$cnt" = "0" ]; then
+        echo "  ✓ all indexes dropped"
+        break
+    fi
+done
+
+# ---------------------------------------------------------------------------
+# Verdict
+# ---------------------------------------------------------------------------
+banner "Verdict"
+
+FINAL_COUNT=$(count_demo_indexes)
+PG_INDEXES=$($PSQL -Atq -c "SELECT count(*) FROM pg_indexes WHERE tablename = 'demo_table' AND indexname LIKE 'auto\\_idx\\_%'")
+
+echo ""
+echo "Indexes created in Phase A:  $INITIAL_COUNT"
+echo "Indexes still alive:         $FINAL_COUNT  (auto_index_catalog)"
+echo "Indexes still alive:         $PG_INDEXES  (pg_indexes)"
+
+if [ "$INITIAL_COUNT" -ge 2 ] && [ "$FINAL_COUNT" = "0" ] && [ "$PG_INDEXES" = "0" ]; then
+    echo ""
+    echo "✓ DEMO PASSED"
+    echo "  Phase A created at least one singleton AND one composite."
+    echo "  Phase B dropped them all after the idle accumulator fired."
+elif [ "$INITIAL_COUNT" -ge 1 ] && [ "$FINAL_COUNT" = "0" ]; then
+    echo ""
+    echo "△ PARTIAL"
+    echo "  Indexes were created and dropped, but not both types in Phase A."
+    echo "  (Try larger ROWS or longer READ_ITERS for the composite path.)"
+else
+    echo ""
+    echo "✗ DEMO FAILED"
+    echo "  Either Phase A didn't create indexes, or Phase B didn't drop them."
+    echo "  Try IDLE_INTERVALS=20 (drop budget) or ROWS=200000 (clearer signal)."
+fi
+
+# ---------------------------------------------------------------------------
+# Cleanup (leave demo_table for inspection — reset GUCs only)
+# ---------------------------------------------------------------------------
+banner "Cleanup"
+
+$PSQL -c "ALTER SYSTEM RESET auto_index.create_strategy;"
+$PSQL -c "ALTER SYSTEM RESET auto_index.threshold;"
+$PSQL -c "ALTER SYSTEM RESET auto_index.simple_threshold;"
+$PSQL -c "ALTER SYSTEM RESET auto_index.check_interval;"
+$PSQL -c "SELECT pg_reload_conf();" > /dev/null
+echo "Done.  demo_table left in place — inspect with: scripts/run.sh psql"
